 @interface AVPLoader : NSObject <AVAssetResourceLoaderDelegate> {
     struct ao *ao;
 @public
@@ -1163,6 +1165,47 @@ static int control(struct ao *ao, enum aocontrol cmd, void *arg)
         ao_request_reload(ao);
