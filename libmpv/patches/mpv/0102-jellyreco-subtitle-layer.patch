+// Take the host's subtitle layer when its address option changes: retain it,
+// slave it to the video's timebase, and let go of the previous one.
+static bool update_osd_layer_attachment(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    intptr_t wanted = p->opts ? (intptr_t)p->opts->osd_layer : 0;
+    if ((intptr_t)(__bridge void *)p->osdLayer == wanted)
+        return false;
+
+    if (p->osdLayer) {
+        sample_buffer_renderer_flush(p->osdLayer, true);
+        p->osdLayer.controlTimebase = NULL;
+        [p->osdLayer release];
+        p->osdLayer = nil;
+    }
+    if (wanted) {
+        id layer = (__bridge id)(void *)wanted;
+        if ([layer isKindOfClass:[AVSampleBufferDisplayLayer class]]) {
+            p->osdLayer = [layer retain];
+            if (p->timebase)
+                p->osdLayer.controlTimebase = p->timebase;
+        } else {
+            MP_ERR(vo, "--avfoundation-osd-layer must identify an AVSampleBufferDisplayLayer\n");
+        }
+    }
+    MP_VERBOSE(vo, "Subtitle layer %s\n", p->osdLayer ? "attached" : "detached");
+    return true;
+}
