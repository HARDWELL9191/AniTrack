{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the AniReco window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://graphql.anilist.co" },
        { "url": "https://graphql.anilist.co/*" },
        { "url": "https://kitsu.app/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://anilist.co/*" }
      ]
    }
  ]
}
