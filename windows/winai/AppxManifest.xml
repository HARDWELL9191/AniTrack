<?xml version="1.0" encoding="utf-8"?>
<!-- Identity-only package for AniTrack's Windows AI helper ("packaged with external location"):
     the files stay in AniTrack's install folder; this package only gives the helper the identity
     and the systemAIModels capability Windows requires for its on-device language model.
     __VERSION__, __FRAMEWORK_NAME__ and __FRAMEWORK_VERSION__ are filled in by the build. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="AniTrack.WindowsAI" Publisher="CN=AniTrack" Version="__VERSION__" ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>AniTrack Windows AI</DisplayName>
    <PublisherDisplayName>AniTrack</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26300.0" />
    <PackageDependency Name="__FRAMEWORK_NAME__" MinVersion="__FRAMEWORK_VERSION__"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Windows' on-device language model; declared as a restricted capability, as in
         Microsoft's current Windows AI guides. -->
    <rescap:Capability Name="systemAIModels" />
  </Capabilities>

  <Applications>
    <Application Id="AniTrackAI" Executable="ai-helper\AniTrack.AI.exe"
      uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="AniTrack Windows AI"
        Description="Writes AniTrack's 'Why would I like this?' explanations with Windows' on-device language model."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
