{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JellyReco",
  "version": "1.0.0",
  "identifier": "com.tim.jellyreco",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JellyReco",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss: ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ai/": "ai/",
      "resources/mpv/": "mpv/"
    },
    "shortDescription": "JellyReco",
    "longDescription": "A Jellyfin client for Windows on Arm with an mpv player and personal picks.",
    "copyright": "Unofficial Jellyfin client",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
